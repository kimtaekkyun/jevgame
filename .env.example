# Keep these values on the server. Never use NEXT_PUBLIC_ for secrets.
# TypeSafe is preferred when both provider keys are set.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Used when TYPESAFE_API_KEY is not set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~typesafe/jev-latest
APP_URL=http://localhost:3000
